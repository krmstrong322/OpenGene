{
  "name": "opengene-desktop",
  "version": "0.1.0",
  "description": "OpenGene desktop app — Electron shell around the local plasmid engine",
  "author": "OpenGene",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "stage": "node scripts/stage.js",
    "start": "npm run stage && electron .",
    "dist": "npm run stage && electron-builder --publish never",
    "dist:mac": "npm run stage && electron-builder --publish never --mac",
    "dist:win": "npm run stage && electron-builder --publish never --win",
    "dist:linux": "npm run stage && electron-builder --publish never --linux"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "repository": "github:krmstrong322/OpenGene"
}
